@@ -0,0 +1,197 @@
+from __future__ import annotations++import hashlib+import json+import re+import subprocess+import sys+import tempfile+import unittest+from pathlib import Path+from unittest import mock++ROOT = Path(__file__).resolve().parents[1]+if str(ROOT / "tools") not in sys.path:+    sys.path.insert(0, str(ROOT / "tools"))+if str(ROOT / "tests") not in sys.path:+    sys.path.insert(0, str(ROOT / "tests"))++import export_github_pages as pages  # noqa: E402+import toplist_compat  # noqa: E402+++SOURCE_SITE = ROOT / ".scratch/offline-navigation-20261015-v15/site"+PROTOTYPE_ROUTE = toplist_compat.TOPLIST_PROTOTYPE_ROUTE+LOGIC_ROUTE = toplist_compat.TOPLIST_LOGIC_ROUTE+PIXEL_LITERAL = 'src=\\"/toplist/images/pixel.gif\\"'+++class _RecordingLocalizer:+    def __init__(self, value: str = "/WOW-Encyclopedia-Deployable-Archive/__offline/missing-image.svg?source=fixture"):+        self.value = value+        self.calls: list[dict[str, str]] = []++    def localize(self, raw: str, *, base_url: str, context: str, recorder) -> str:+        self.calls.append({"raw": raw, "base_url": base_url, "context": context})+        return self.value+++class ToplistCompatibilityTests(unittest.TestCase):+    def _source_text(self, route: str) -> str:+        return (SOURCE_SITE / route.lstrip("/")).read_bytes().decode("utf-8")++    def _append_source_record(self, manifest: Path, route: str) -> None:+        source = SOURCE_SITE / route.lstrip("/")+        data = source.read_bytes()+        payload = json.loads(manifest.read_text(encoding="utf-8"))+        payload["files"].append(+            {+                "route": route,+                "output_path": "offline/site/" + route.lstrip("/"),+                "derived_sha256": hashlib.sha256(data).hexdigest(),+                "derived_length": len(data),+                "mime": "application/javascript",+                "kind": "js",+                "source_base_url": "http://www.worldofwarcraft.com" + route,+            }+        )+        manifest.write_text(json.dumps(payload), encoding="utf-8")++    def test_actual_source15_assets_export_and_node_check(self) -> None:+        """The exporter branch handles both frozen files without generic rewrites."""++        with tempfile.TemporaryDirectory() as tmp:+            from test_github_pages_export import GithubPagesExportTests++            base, site, manifest = GithubPagesExportTests()._fixture(Path(tmp))+            for route in (PROTOTYPE_ROUTE, LOGIC_ROUTE):+                source = SOURCE_SITE / route.lstrip("/")+                destination = site / route.lstrip("/")+                destination.parent.mkdir(parents=True, exist_ok=True)+                destination.write_bytes(source.read_bytes())+                self._append_source_record(manifest, route)++            output = base / "pages"+            result = pages.export_pages(+                source_site=site,+                manifest_path=manifest,+                output=output,+                workspace_root=base,+                max_bytes=None,+                min_free_bytes=0,+            )+            self.assertGreaterEqual(result["stats"].get("toplist_compat_repaired", 0), 2)++            prototype_output = output / PROTOTYPE_ROUTE.lstrip("/")+            logic_output = output / LOGIC_ROUTE.lstrip("/")+            self.assertEqual(prototype_output.read_bytes().decode("utf-8"), self._source_text(PROTOTYPE_ROUTE))++            source_logic = self._source_text(LOGIC_ROUTE)+            derived_logic = logic_output.read_bytes().decode("utf-8")+            self.assertEqual(source_logic.count(PIXEL_LITERAL), 5)+            self.assertEqual(derived_logic.count(PIXEL_LITERAL), 0)+            urls = re.findall(r'src=\\"([^"\\]+)\\"', derived_logic)+            self.assertEqual(len(urls), 5)+            self.assertEqual(len(set(urls)), 1)+            self.assertTrue(urls[0].startswith("/WOW-Encyclopedia-Deployable-Archive/__offline/missing-image.svg?"))+            replacement = 'src=\\"' + urls[0] + '\\"'+            self.assertEqual(derived_logic, source_logic.replace(PIXEL_LITERAL, replacement))++            node = "node"+            for path in (prototype_output, logic_output):+                checked = subprocess.run(+                    [node, "--check", str(path)],+                    capture_output=True,+                    text=True,+                    encoding="utf-8",+                    timeout=15,+                )+                self.assertEqual(checked.returncode, 0, checked.stderr)++            provenance = json.loads((output / "export-provenance.json").read_text(encoding="utf-8"))+            rows = {row["route"]: row for row in provenance["files"] if row["route"] in {PROTOTYPE_ROUTE, LOGIC_ROUTE}}+            self.assertIn("Toplist compatibility guard preserved", rows[PROTOTYPE_ROUTE].get("derivation_reason", ""))+            self.assertIn("exactly five escaped pixel", rows[LOGIC_ROUTE].get("derivation_reason", ""))++    def test_source_and_route_guards(self) -> None:+        prototype = self._source_text(PROTOTYPE_ROUTE)+        localizer = _RecordingLocalizer()+        rewritten, handled = toplist_compat.rewrite_toplist_script(+            prototype,+            PROTOTYPE_ROUTE,+            toplist_compat.TOPLIST_PROTOTYPE_SOURCE_SHA256,+            "http://www.worldofwarcraft.com" + PROTOTYPE_ROUTE,+            localizer,+            None,+        )+        self.assertTrue(handled)+        self.assertEqual(rewritten, prototype)+        self.assertEqual(localizer.calls, [])++        with self.assertRaisesRegex(toplist_compat.ToplistCompatError, "source SHA mismatch"):+            toplist_compat.rewrite_toplist_script(+                prototype,+                PROTOTYPE_ROUTE,+                "0" * 64,+                "http://www.worldofwarcraft.com" + PROTOTYPE_ROUTE,+                _RecordingLocalizer(),+                None,+            )+        with self.assertRaisesRegex(toplist_compat.ToplistCompatError, "text SHA mismatch"):+            toplist_compat.rewrite_toplist_script(+                prototype + "\n",+                PROTOTYPE_ROUTE,+                toplist_compat.TOPLIST_PROTOTYPE_SOURCE_SHA256,+                "http://www.worldofwarcraft.com" + PROTOTYPE_ROUTE,+                _RecordingLocalizer(),+                None,+            )++        unrelated, handled = toplist_compat.rewrite_toplist_script(+            "var value = '/toplist/images/pixel.gif';",+            "/other/script.js",+            "0" * 64,+            "http://www.worldofwarcraft.com/other/script.js",+            _RecordingLocalizer(),+            None,+        )+        self.assertFalse(handled)+        self.assertEqual(unrelated, "var value = '/toplist/images/pixel.gif';")++    def test_logic_count_guard_and_localizer_context(self) -> None:+        source = self._source_text(LOGIC_ROUTE)+        mutated = source.replace(PIXEL_LITERAL, "", 1)+        mutated_sha = hashlib.sha256(mutated.encode("utf-8")).hexdigest()+        localizer = _RecordingLocalizer()+        with mock.patch.object(toplist_compat, "TOPLIST_LOGIC_SOURCE_SHA256", mutated_sha):+            with self.assertRaisesRegex(toplist_compat.ToplistCompatError, "pixel literal count mismatch"):+                toplist_compat.rewrite_toplist_script(+                    mutated,+                    LOGIC_ROUTE,+                    mutated_sha,+                    "http://www.worldofwarcraft.com" + LOGIC_ROUTE,+                    localizer,+                    None,+                )+        self.assertEqual(localizer.calls, [])++        localizer = _RecordingLocalizer()+        rewritten, handled = toplist_compat.rewrite_toplist_script(+            source,+            LOGIC_ROUTE,+            toplist_compat.TOPLIST_LOGIC_SOURCE_SHA256,+            "http://www.worldofwarcraft.com" + LOGIC_ROUTE,+            localizer,+            None,+        )+        self.assertTrue(handled)+        self.assertEqual(len(localizer.calls), 5)+        self.assertTrue(all(call["raw"] == "/toplist/images/pixel.gif" for call in localizer.calls))+        self.assertTrue(all(call["context"] == "image" for call in localizer.calls))+        self.assertEqual(rewritten.count(PIXEL_LITERAL), 0)+        self.assertEqual(rewritten.count('src=\\"/WOW-Encyclopedia-Deployable-Archive/__offline/missing-image.svg?source=fixture\\"'), 5)+++if __name__ == "__main__":+    unittest.main()+