        "text": "\t\tAlready have a World of Warcraft Rewards Visa Card? &nbsp; &nbsp; <a href=\"/visa/reward/index.html\">Continue to the Rewards Site</a>"
      },
      {
        "line": 20,
        "text": "\t\t<div class=\"slideshow\"><object classid=\"clsid:d27cdb6e-ae6d-11cf-96b8-444553540000\" codebase=\"http://fpdownload.macromedia.com/pub/shockwave/cabs/flash/swflash.cab#version=8,0,0,0\" width=\"308\" height=\"504\" id=\"slideshow\" align=\"top\"><param name=\"allowScriptAccess\" value=\"sameDomain\" /><param name=\"movie\" value=\"images/slideshow.swf\" /><param name=\"quality\" value=\"high\" /><param name=\"bgcolor\" value=\"#000000\" /><param name=\"wmode\" value=\"transparent\" /><embed src=\"/visa/images/slideshow.swf\" wmode=\"transparent\" quality=\"high\" bgcolor=\"#000000\" width=\"308\" height=\"504\" name=\"slideshow\" align=\"top\" allowscriptaccess=\"sameDomain\" type=\"application/x-shockwave-flash\" pluginspage=\"http://www.macromedia.com/go/getflashplayer\" /></object></div>"
      },
      {
        "line": 23,
        "text": "\t\t<div class=\"SignUpLink\"><a href=\"/__offline/missing.html?source=http%3A%2F%2Fwww.worldofwarcraft.com%2Fvisa%2F&amp;requested=http%3A%2F%2Fwww.visa.com&amp;reason=external-or-uncollected-resource\"><img src=\"/__offline/missing-image.svg?source=http%3A%2F%2Fwww.worldofwarcraft.com%2Fvisa%2F&amp;requested=http%3A%2F%2Fwww.worldofwarcraft.com%2Fvisa%2Fimages%2Fpixel.gif&amp;reason=invalid-overlay-or-uncollected-site-resource\" width=\"450\" height=\"112\" border=\"0\" alt=\"Sign Up for a World of Warcraft VISA Card\" /></a></div>"
      },
      {
        "line": 53,
        "text": "\t\t\t\t<a href=\"/__offline/missing.html?source=http%3A%2F%2Fwww.worldofwarcraft.com%2Fvisa%2F&amp;requested=http%3A%2F%2Fwww.worldofwarcraft.com%2Fvisa%2Fbenefits.jsp&amp;reason=invalid-overlay-or-uncollected-site-resource\" class=\"benefitslink\">Click here</a> for additional Card benefits and services."
      },
      {
        "line": 55,
        "text": "\t\t\t\t<p><b><font color=\"#FFCC00\"><br>In order to apply, you must be of legal age and have a U.S. address.</font></b></p>"
